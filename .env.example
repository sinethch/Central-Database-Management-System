# ==============================================================================
# Target PostgreSQL Database Configuration
# ==============================================================================
# The target database to monitor and backup (read-only / non-intrusive)
# For Docker Compose demo: postgresql://postgres:postgres@target-postgres-demo:5432/demo_db
# Replace this sample URL with a target that is safe for your environment.
TARGET_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/demo_db

# ==============================================================================
# Management Application Settings
# ==============================================================================
MANAGEMENT_HOST=0.0.0.0
MANAGEMENT_PORT=8080
API_KEY=dbops-control-plane-api-key

# ==============================================================================
# Backup Configuration
# ==============================================================================
BACKUP_SCHEDULE="0 2 * * *"            # Every day at 2:00 AM UTC (cron format)
BACKUP_RETENTION_DAYS=14                # Automatically prune backups older than 14 days
BACKUP_STORAGE_DIR="./backups"          # Or /var/backups inside container
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret # Required for encrypted snapshots; changing it makes existing encrypted snapshots unreadable
DATABASE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret # Required to encrypt registered database passwords and Telegram tokens
AUTH_TOTP_ENCRYPTION_KEY=          # Stable secret for encrypting authenticator seeds; keep backed up
SERVER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret # Required before registering remote SSH credentials
SSH_KNOWN_HOSTS_PATH=./ssh/known_hosts # Or set this to your terminal's existing known_hosts file

# ==============================================================================
# Health & Performance Alert Thresholds
# ==============================================================================
SLOW_QUERY_THRESHOLD_SECONDS=5.0        # Flag queries taking longer than 5 seconds
MAX_CONNECTION_WARNING_PERCENT=80.0     # Alert when pool exceeds 80% of max_connections
BUFFER_CACHE_HIT_WARNING_PERCENT=95.0   # Alert when buffer cache hit ratio drops below 95%

# ==============================================================================
# Notification Channels (Optional)
# ==============================================================================
ALERT_WEBHOOK_URL=                      # e.g. https://hooks.slack.com/services/... or Discord/Teams
ALERT_TELEGRAM_BOT_TOKEN=               # e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
ALERT_TELEGRAM_CHAT_ID=                 # e.g. -1001234567890

# SMTP Email Alerting (Optional)
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=dba-alerts@example.com
ALERT_EMAIL_FROM=dbops-noreply@example.com


# Initial administrator account (change before deployment)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=AdminBackup

# Local-only credentials for the second PostgreSQL recovery-test container
QA2_POSTGRES_PASSWORD=qa2-local-only-change-this
